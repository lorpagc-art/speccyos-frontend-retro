{
  "soc": "Snapdragon 865",
  "modes": {
    "ECO": {
      "cpu_cluster0_gov": "powersave",
      "cpu_cluster1_gov": "powersave",
      "gpu_governor": "powersave",
      "io_scheduler": "noop",
      "fan_level": 0,
      "description": "Máxima batería para sesiones de RPG clásicos."
    },
    "BALANCED": {
      "cpu_cluster0_gov": "schedutil",
      "cpu_cluster1_gov": "schedutil",
      "gpu_governor": "msm-adreno-tz",
      "io_scheduler": "cfq",
      "fan_level": 1,
      "description": "Equilibrio térmico. Perfecto para PS1 y Saturn."
    },
    "PERFORMANCE": {
      "cpu_cluster0_gov": "performance",
      "cpu_cluster1_gov": "performance",
      "gpu_governor": "performance",
      "io_scheduler": "deadline",
      "fan_level": 2,
      "description": "Rendimiento estable. Optimizado para GameCube y 3DS."
    },
    "EXTREME": {
      "cpu_cluster0_gov": "performance",
      "cpu_cluster1_gov": "performance",
      "gpu_governor": "performance",
      "touch_boost": true,
      "io_scheduler": "deadline",
      "fan_level": 3,
      "description": "Frecuencias Turbo. Potencia total para PS2 y Switch."
    }
  },
  "sysfs_mapping": {
    "cpu0_path": "/sys/devices/system/cpu/cpufreq/policy0/scaling_governor",
    "cpu1_path": "/sys/devices/system/cpu/cpufreq/policy4/scaling_governor",
    "cpu2_path": "/sys/devices/system/cpu/cpufreq/policy7/scaling_governor",
    "gpu_path": "/sys/class/kgsl/kgsl-3d0/devfreq/governor",
    "fan_path": "/sys/class/thermal/cooling_device0/cur_state",
    "io_sched_path": "/sys/block/mmcblk0/queue/scheduler"
  }
}