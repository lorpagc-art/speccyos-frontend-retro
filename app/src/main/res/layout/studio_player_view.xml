<?xml version="1.0" encoding="utf-8"?>
<!--
  Reproductor de las tarjetas del tema Studio. TextureView en vez de SurfaceView
  y obturador transparente: asi la caratula que hay debajo sigue viendose hasta
  que llega el primer fotograma, en lugar de un rectangulo negro.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/transparent" />
