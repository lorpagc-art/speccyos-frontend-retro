rules_version = '2';

// SpeccyOS — reglas de Cloud Storage.
// Las partidas se indexan por UID de Firebase Auth, no por correo electrónico.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/saves/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Límite de 20 MB por fichero: un save state legítimo nunca lo supera y
      // evita que la cuota de almacenamiento se pueda agotar a propósito.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
